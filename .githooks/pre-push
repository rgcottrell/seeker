#!/usr/bin/env bash
#
# Source-controlled pre-push gate. Runs the full warning-clean check
# (scripts/check.sh: fmt + clippy -D warnings + build) before any push, so a
# branch is PR-ready. Commits are intentionally NOT gated — save WIP freely.
#
# Activated automatically by build.rs (core.hooksPath); scripts/install-hooks.sh
# is the manual fallback. Bypass a single push with `git push --no-verify`.
set -euo pipefail

# Skip in CI: the workflow runs the gate in its own job, so a hook firing on an
# in-CI push (release/format bots) would only duplicate it. `CI` is the standard
# signal GitHub Actions et al. already set — no project-specific override needed.
if [ -n "${CI:-}" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
exec "$repo_root/scripts/check.sh"
